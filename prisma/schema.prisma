datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  providers    AiProvider[]
}

model Project {
  id           String        @id @default(uuid())
  name         String
  description  String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        File[]
  reviews      Review[]
  chatSessions ChatSession[]
}

model File {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  name      String
  content   String
  size      Int
  language  String
  createdAt DateTime @default(now())
}

model AiProvider {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  baseUrl   String
  apiKey    String?
  modelName String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String   // SECURITY, PERFORMANCE, CODE_QUALITY, TECH_DEBT
  summary   String
  issues    String   // JSON string of array of issues
  score     Int?
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(uuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String        @default("New Chat Session")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          String      // "user" | "assistant" | "system"
  content       String
  createdAt     DateTime    @default(now())
}
